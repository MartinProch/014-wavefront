# Used by server.js (Node proxy for desktop preview, port 3456). NOT read by
# wavefront-mobile.html — the mobile app has no build step / Node runtime, so
# its API keys are hardcoded JS constants directly in the HTML (FMP_KEY,
# FINNHUB_API_KEY, TWELVE_DATA_API_KEY, ALPHA_VANTAGE_API_KEY near the top of
# the <script> tag). Update both places if you rotate a key.

# Financial Modeling Prep — primary data source (quotes, OHLCV, fundamentals)
FMP_KEY=

# Finnhub — fallback #1 (quotes, basic fundamentals, news/sentiment).
# Free tier: 60 req/min, but historical /stock/candle requires a paid plan.
FINNHUB_KEY=

# Polygon.io — legacy/secondary source, NOT reliable for historical OHLCV on
# the free tier (returns NOT_AUTHORIZED). Kept for reference only.
POLYGON_KEY=

# Twelve Data — fallback #2, used mainly for historical OHLCV + quotes.
# Free tier: 800 req/day. Get a key at https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Alpha Vantage — fallback #3 (last resort), fundamentals + historical data.
# Free tier: 25 req/day, 5 req/min. Get a key at https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=
